# ── Required ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_in_production
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# ── Optional paths ─────────────────────────────────────────────────────────────
NEMWEB_CACHE_DIR=./cache/nemweb

# ── Development only — NEVER set true in production ───────────────────────────
# Bypasses JWT auth so you can use the app without logging in.
GRIDVERDICT_DEV_NO_AUTH=true

# ── LLM decomposer backend ────────────────────────────────────────────────────
# Options: ollama (default) | claude | rule_based
# rule_based works fully offline — good for CI and first-run demos.
# ollama requires Ollama running at OLLAMA_BASE_URL with OLLAMA_MODEL pulled.
# claude requires ANTHROPIC_API_KEY.
DECOMPOSER_BACKEND=rule_based

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=sk-ant-...

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Experimental forecasters (TCN, GBM ensemble) ─────────────────────────────
ENABLE_EXPERIMENTAL_SEQUENCE_FORECASTERS=true
