          "legendFormat": "Dispatch age (s)",
          "refId": "A"
        }
      ],
      "title": "Dispatch Age Over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
